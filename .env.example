# Admin authentication passwords
ADMIN_PASSWORD=your_super_admin_password
MANAGER_PASSWORD=your_event_manager_password
ADMIN_SECRET=your_jwt_secret_key

# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: Vercel Blob (for persistent poster uploads in production)
# BLOB_READ_WRITE_TOKEN=
